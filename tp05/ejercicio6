def buscar_elemento(lista):
    errores = 0
    while errores < 3:
        try:
            elemento = int(input("Ingrese el elemento a buscar: "))
            posicion = lista.index(elemento)
            print(f"El elemento {elemento} se encuentra en la posición {posicion}.")
            return
        except ValueError:
            errores += 1
            print(f"Error: el elemento no está en la lista. Intentos restantes: {3 - errores}.")
    print("Se alcanzó el límite de errores.")

def main():
    lista = []
    print("Ingrese números enteros para la lista (finalice con -1):")
    while True:
        try:
            numero = int(input())
            if numero == -1:
                break
            lista.append(numero)
        except ValueError:
            print("Ingrese un número válido.")
    print(f"Lista cargada: {lista}")
    buscar_elemento(lista)

if __name__ == "__main__":
    main()
